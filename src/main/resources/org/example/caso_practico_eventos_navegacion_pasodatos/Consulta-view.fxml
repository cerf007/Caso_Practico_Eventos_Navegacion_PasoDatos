<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="560.0" prefWidth="900.0"
            style="-fx-background-color: #eef3f6;"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.caso_practico_eventos_navegacion_pasodatos.controllers.ConsultaController">

    <top>
        <VBox spacing="3.0" style="-fx-background-color: linear-gradient(to right, #0f2d3d, #1f5d73); -fx-padding: 18 28;">
            <Label text="Consultar Clientes"
                   style="-fx-text-fill: white; -fx-font-family: 'Segoe UI Semibold'; -fx-font-size: 24px; -fx-font-weight: bold;"/>
            <Label text="Listado de clientes registrados en memoria"
                   style="-fx-text-fill: #d6e8ef; -fx-font-family: 'Segoe UI'; -fx-font-size: 12px;"/>
        </VBox>
    </top>

    <center>
        <VBox spacing="12.0" style="-fx-padding: 24;">
            <VBox spacing="0.0"
                  style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-color: #d0dbe3; -fx-border-radius: 10; -fx-effect: dropshadow(gaussian, rgba(15,45,61,0.13), 14, 0, 0, 3);">
                <TableView fx:id="tblClientes" onMouseClicked="#manejarClicTabla" prefHeight="360.0"
                           style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-font-family: 'Segoe UI'; -fx-control-inner-background: white; -fx-table-cell-border-color: #e0e7ee;">
                    <tooltip>
                        <Tooltip text="Doble clic sobre un cliente para abrir la ventana de detalle"/>
                    </tooltip>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                    <columns>
                        <TableColumn fx:id="colId" prefWidth="80.0" text="ID"/>
                        <TableColumn fx:id="colNombres" prefWidth="190.0" text="Nombre completo"/>
                        <TableColumn fx:id="colTipo" prefWidth="130.0" text="Tipo de cliente"/>
                        <TableColumn fx:id="colCiudad" prefWidth="120.0" text="Ciudad"/>
                        <TableColumn fx:id="colFechaNacimiento" prefWidth="145.0" text="Fecha nacimiento"/>
                        <TableColumn fx:id="colSolicitud" prefWidth="135.0" text="Tipo solicitud"/>
                        <TableColumn fx:id="colAcciones" prefWidth="170.0" text="Acciones"/>
                    </columns>
                </TableView>

                <HBox alignment="CENTER_LEFT" spacing="10.0"
                      style="-fx-background-color: #f7f9fb; -fx-background-radius: 0 0 10 10; -fx-border-color: #d9e1e8 transparent transparent transparent; -fx-padding: 10 12;">
                    <Label fx:id="lblRegistrosEncontrados" text="0 registros encontrados"
                           style="-fx-text-fill: #5f6f7f; -fx-font-family: 'Segoe UI'; -fx-font-size: 12px;">
                        <tooltip>
                            <Tooltip text="Cantidad de clientes mostrados en la tabla"/>
                        </tooltip>
                    </Label>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="&lt;" prefHeight="28.0" prefWidth="34.0"
                            style="-fx-background-color: #edf1f4; -fx-border-color: #c8d2dc; -fx-border-radius: 6; -fx-background-radius: 6; -fx-text-fill: #3f4a56;">
                        <tooltip>
                            <Tooltip text="Pagina anterior"/>
                        </tooltip>
                    </Button>
                    <Button text="1" prefHeight="28.0" prefWidth="34.0"
                            style="-fx-background-color: #0e7182; -fx-background-radius: 6; -fx-text-fill: white; -fx-font-family: 'Segoe UI Semibold';">
                        <tooltip>
                            <Tooltip text="Pagina actual"/>
                        </tooltip>
                    </Button>
                    <Button text="&gt;" prefHeight="28.0" prefWidth="34.0"
                            style="-fx-background-color: #edf1f4; -fx-border-color: #c8d2dc; -fx-border-radius: 6; -fx-background-radius: 6; -fx-text-fill: #3f4a56;">
                        <tooltip>
                            <Tooltip text="Pagina siguiente"/>
                        </tooltip>
                    </Button>
                </HBox>
            </VBox>
        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER_RIGHT"
              style="-fx-background-color: white; -fx-border-color: #dce5ec transparent transparent transparent; -fx-padding: 12 20;">
            <Button fx:id="btnCerrar" text="Volver al menu" cancelButton="true" onAction="#cerrarVentana"
                    style="-fx-background-color: #f7fafc; -fx-border-color: #b7c5cf; -fx-border-radius: 8; -fx-background-radius: 8; -fx-text-fill: #173042; -fx-padding: 8 16;">
                <tooltip>
                    <Tooltip text="Cierra la consulta y vuelve al menu"/>
                </tooltip>
            </Button>
        </HBox>
    </bottom>
</BorderPane>
