<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="430.0" prefWidth="680.0" spacing="12.0"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.caso_practico_eventos_navegacion_pasodatos.controllers.ConsultaController">
    <padding>
        <Insets bottom="18.0" left="18.0" right="18.0" top="18.0"/>
    </padding>

    <Label text="Consulta de Clientes"/>
    <TableView fx:id="tblClientes" onMouseClicked="#manejarClicTabla" prefHeight="320.0">
        <columns>
            <TableColumn fx:id="colNombres" prefWidth="190.0" text="Nombre completo"/>
            <TableColumn fx:id="colTipo" prefWidth="130.0" text="Tipo"/>
            <TableColumn fx:id="colCiudad" prefWidth="120.0" text="Ciudad"/>
            <TableColumn fx:id="colSolicitud" prefWidth="160.0" text="Solicitud"/>
        </columns>
    </TableView>

    <HBox alignment="CENTER_RIGHT">
        <Button fx:id="btnCerrar" cancelButton="true" onAction="#cerrarVentana" text="Cerrar"/>
    </HBox>
</VBox>
