<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="700.0" prefWidth="840.0"
            style="-fx-background-color: #eef3f6;"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.caso_practico_eventos_navegacion_pasodatos.controllers.ClienteController">
    <top>
        <VBox spacing="3.0" style="-fx-background-color: linear-gradient(to right, #0f2d3d, #1f5d73); -fx-padding: 18 28;">
            <Label text="Registro de cliente"
                   style="-fx-text-fill: white; -fx-font-family: 'Segoe UI Semibold'; -fx-font-size: 24px; -fx-font-weight: bold;"/>
            <Label text="Formulario para registrar datos basicos y solicitud asociada"
                   style="-fx-text-fill: #d6e8ef; -fx-font-family: 'Segoe UI'; -fx-font-size: 12px;"/>
        </VBox>
    </top>

    <center>
        <GridPane hgap="16.0" vgap="13.0"
                  style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-color: #d0dbe3; -fx-border-radius: 12; -fx-padding: 24; -fx-effect: dropshadow(gaussian, rgba(15,45,61,0.13), 14, 0, 0, 3);">
            <BorderPane.margin>
                <Insets bottom="22.0" left="22.0" right="22.0" top="22.0"/>
            </BorderPane.margin>

            <columnConstraints>
                <ColumnConstraints minWidth="170.0"/>
                <ColumnConstraints minWidth="470.0"/>
            </columnConstraints>
            <rowConstraints>
                <RowConstraints minHeight="36.0"/>
                <RowConstraints minHeight="36.0"/>
                <RowConstraints minHeight="36.0"/>
                <RowConstraints minHeight="36.0"/>
                <RowConstraints minHeight="36.0"/>
                <RowConstraints minHeight="36.0"/>
                <RowConstraints minHeight="36.0"/>
                <RowConstraints minHeight="132.0"/>
                <RowConstraints minHeight="86.0"/>
            </rowConstraints>

            <Label text="Nombres:" GridPane.columnIndex="0" GridPane.rowIndex="0"
                   style="-fx-text-fill: #263845; -fx-font-family: 'Segoe UI Semibold'; -fx-font-weight: bold;"/>
            <TextField fx:id="txtNombres" promptText="Ingrese nombres" prefWidth="290.0"
                       GridPane.columnIndex="1" GridPane.rowIndex="0">
                <tooltip>
                    <Tooltip text="Solo permite letras en el nombre"/>
                </tooltip>
            </TextField>

            <Label text="Apellidos:" GridPane.columnIndex="0" GridPane.rowIndex="1"
                   style="-fx-text-fill: #263845; -fx-font-family: 'Segoe UI Semibold'; -fx-font-weight: bold;"/>
            <TextField fx:id="txtApellidos" promptText="Ingrese apellidos" prefWidth="290.0"
                       GridPane.columnIndex="1" GridPane.rowIndex="1"/>

            <Label text="Tipo de cliente:" GridPane.columnIndex="0" GridPane.rowIndex="2"
                   style="-fx-text-fill: #263845; -fx-font-family: 'Segoe UI Semibold'; -fx-font-weight: bold;"/>
            <ComboBox fx:id="cmbTipoCliente" prefWidth="290.0" GridPane.columnIndex="1" GridPane.rowIndex="2">
                <tooltip>
                    <Tooltip text="Seleccione si es persona natural o empresa"/>
                </tooltip>
            </ComboBox>

            <Label text="Ciudad:" GridPane.columnIndex="0" GridPane.rowIndex="3"
                   style="-fx-text-fill: #263845; -fx-font-family: 'Segoe UI Semibold'; -fx-font-weight: bold;"/>
            <ComboBox fx:id="cmbCiudad" prefWidth="290.0" GridPane.columnIndex="1" GridPane.rowIndex="3">
                <tooltip>
                    <Tooltip text="Seleccione una ciudad de Nicaragua"/>
                </tooltip>
            </ComboBox>

            <Label text="Fecha de nacimiento:" GridPane.columnIndex="0" GridPane.rowIndex="4"
                   style="-fx-text-fill: #263845; -fx-font-family: 'Segoe UI Semibold'; -fx-font-weight: bold;"/>
            <DatePicker fx:id="dpFechaNacimiento" prefWidth="290.0" GridPane.columnIndex="1" GridPane.rowIndex="4"/>

            <Label text="Tipo de solicitud:" GridPane.columnIndex="0" GridPane.rowIndex="5"
                   style="-fx-text-fill: #263845; -fx-font-family: 'Segoe UI Semibold'; -fx-font-weight: bold;"/>
            <HBox spacing="18.0" GridPane.columnIndex="1" GridPane.rowIndex="5">
                <RadioButton text="Instalacion">
                    <toggleGroup>
                        <ToggleGroup fx:id="tgTipoSolicitud"/>
                    </toggleGroup>
                </RadioButton>
                <RadioButton text="Reparacion" toggleGroup="$tgTipoSolicitud"/>
                <RadioButton text="Consulta" toggleGroup="$tgTipoSolicitud"/>
            </HBox>

            <Label text="Servicios de interes:" GridPane.columnIndex="0" GridPane.rowIndex="6"
                   style="-fx-text-fill: #263845; -fx-font-family: 'Segoe UI Semibold'; -fx-font-weight: bold;"/>
            <HBox spacing="18.0" GridPane.columnIndex="1" GridPane.rowIndex="6">
                <CheckBox fx:id="chkSoporteTecnico" text="Soporte tecnico"/>
                <CheckBox fx:id="chkMantenimiento" text="Mantenimiento"/>
            </HBox>

            <Label text="Fotografia:" GridPane.columnIndex="0" GridPane.rowIndex="7"
                   style="-fx-text-fill: #263845; -fx-font-family: 'Segoe UI Semibold'; -fx-font-weight: bold;"/>
            <HBox alignment="CENTER_LEFT" spacing="18.0" GridPane.columnIndex="1" GridPane.rowIndex="7">
                <ImageView fx:id="imgFoto" fitHeight="120.0" fitWidth="120.0" preserveRatio="true"
                           style="-fx-background-color: #f7fafc; -fx-border-color: #c8d5df; -fx-border-radius: 8; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, rgba(15,45,61,0.12), 8, 0, 0, 2);"/>
                <VBox spacing="8.0">
                    <Button text="Seleccionar fotografia" onAction="#seleccionarFoto"
                            style="-fx-background-color: #f7fafc; -fx-border-color: #b7c5cf; -fx-border-radius: 8; -fx-background-radius: 8; -fx-text-fill: #173042; -fx-padding: 8 14;">
                        <tooltip>
                            <Tooltip text="Abre FileChooser para seleccionar una imagen"/>
                        </tooltip>
                    </Button>
                    <Label text="Formatos permitidos: PNG, JPG, JPEG"
                           style="-fx-text-fill: #657785; -fx-font-family: 'Segoe UI'; -fx-font-size: 12px;"/>
                </VBox>
            </HBox>

            <Label text="Servicios seleccionados:" GridPane.columnIndex="0" GridPane.rowIndex="8"
                   style="-fx-text-fill: #263845; -fx-font-family: 'Segoe UI Semibold'; -fx-font-weight: bold;"/>
            <ListView fx:id="lstServiciosSeleccionados" prefHeight="78.0" prefWidth="290.0"
                      GridPane.columnIndex="1" GridPane.rowIndex="8"/>
        </GridPane>
    </center>

    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="10.0"
              style="-fx-background-color: white; -fx-border-color: #dce5ec transparent transparent transparent; -fx-padding: 12 20;">
            <Button text="Guardar" onAction="#guardar" defaultButton="true"
                    style="-fx-background-color: #0e7182; -fx-background-radius: 8; -fx-text-fill: white; -fx-font-family: 'Segoe UI Semibold'; -fx-font-weight: bold; -fx-padding: 8 18;">
                <tooltip>
                    <Tooltip text="Valida y guarda el cliente en memoria"/>
                </tooltip>
            </Button>
            <Button text="Limpiar" onAction="#limpiar"
                    style="-fx-background-color: #f7fafc; -fx-border-color: #b7c5cf; -fx-border-radius: 8; -fx-background-radius: 8; -fx-text-fill: #173042; -fx-padding: 8 16;"/>
            <Button fx:id="btnCancelar" text="Cancelar" cancelButton="true" onAction="#cancelar"
                    style="-fx-background-color: #fff5f5; -fx-border-color: #d99a9a; -fx-border-radius: 8; -fx-background-radius: 8; -fx-text-fill: #8a1f1f; -fx-padding: 8 16;"/>
        </HBox>
    </bottom>
</BorderPane>
