<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="520.0" prefWidth="700.0"
            style="-fx-background-color: #eef3f6;"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.caso_practico_eventos_navegacion_pasodatos.controllers.DetalleClienteController">
    <top>
        <VBox spacing="3.0" style="-fx-background-color: linear-gradient(to right, #0f2d3d, #1f5d73); -fx-padding: 18 28;">
            <Label text="Detalle del cliente"
                   style="-fx-text-fill: white; -fx-font-family: 'Segoe UI Semibold'; -fx-font-size: 24px; -fx-font-weight: bold;"/>
            <Label text="Informacion recibida desde la consulta de clientes"
                   style="-fx-text-fill: #d6e8ef; -fx-font-family: 'Segoe UI'; -fx-font-size: 12px;"/>
        </VBox>
    </top>

    <center>
        <HBox alignment="TOP_LEFT" spacing="24.0"
              style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-color: #d0dbe3; -fx-border-radius: 12; -fx-padding: 24; -fx-effect: dropshadow(gaussian, rgba(15,45,61,0.13), 14, 0, 0, 3);">
            <BorderPane.margin>
                <Insets bottom="22.0" left="22.0" right="22.0" top="22.0"/>
            </BorderPane.margin>

            <ImageView fx:id="imgFoto" fitHeight="140.0" fitWidth="140.0" preserveRatio="true"
                       style="-fx-background-color: #f7fafc; -fx-border-color: #c8d5df; -fx-border-radius: 8; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, rgba(15,45,61,0.12), 8, 0, 0, 2);"/>

            <GridPane hgap="14.0" vgap="13.0" HBox.hgrow="ALWAYS">
                <columnConstraints>
                    <ColumnConstraints minWidth="160.0"/>
                    <ColumnConstraints minWidth="300.0"/>
                </columnConstraints>
                <rowConstraints>
                    <RowConstraints minHeight="34.0"/>
                    <RowConstraints minHeight="34.0"/>
                    <RowConstraints minHeight="34.0"/>
                    <RowConstraints minHeight="34.0"/>
                    <RowConstraints minHeight="34.0"/>
                    <RowConstraints minHeight="34.0"/>
                </rowConstraints>

                <Label text="Nombre completo:" GridPane.columnIndex="0" GridPane.rowIndex="0"
                       style="-fx-text-fill: #263845; -fx-font-family: 'Segoe UI Semibold'; -fx-font-weight: bold;"/>
                <Label fx:id="lblNombreCompleto" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="0">
                    <tooltip>
                        <Tooltip text="Nombre recibido desde la consulta"/>
                    </tooltip>
                </Label>

                <Label text="Tipo de cliente:" GridPane.columnIndex="0" GridPane.rowIndex="1"
                       style="-fx-text-fill: #263845; -fx-font-family: 'Segoe UI Semibold'; -fx-font-weight: bold;"/>
                <Label fx:id="lblTipoCliente" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="1">
                    <tooltip>
                        <Tooltip text="Tipo de cliente seleccionado en el registro"/>
                    </tooltip>
                </Label>

                <Label text="Ciudad:" GridPane.columnIndex="0" GridPane.rowIndex="2"
                       style="-fx-text-fill: #263845; -fx-font-family: 'Segoe UI Semibold'; -fx-font-weight: bold;"/>
                <Label fx:id="lblCiudad" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="2">
                    <tooltip>
                        <Tooltip text="Ciudad registrada para el cliente"/>
                    </tooltip>
                </Label>

                <Label text="Fecha de nacimiento:" GridPane.columnIndex="0" GridPane.rowIndex="3"
                       style="-fx-text-fill: #263845; -fx-font-family: 'Segoe UI Semibold'; -fx-font-weight: bold;"/>
                <Label fx:id="lblFechaNacimiento" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="3">
                    <tooltip>
                        <Tooltip text="Fecha de nacimiento registrada"/>
                    </tooltip>
                </Label>

                <Label text="Tipo de solicitud:" GridPane.columnIndex="0" GridPane.rowIndex="4"
                       style="-fx-text-fill: #263845; -fx-font-family: 'Segoe UI Semibold'; -fx-font-weight: bold;"/>
                <Label fx:id="lblTipoSolicitud" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="4">
                    <tooltip>
                        <Tooltip text="Tipo de solicitud enviada al detalle"/>
                    </tooltip>
                </Label>

                <Label text="Servicios de interes:" GridPane.columnIndex="0" GridPane.rowIndex="5"
                       style="-fx-text-fill: #263845; -fx-font-family: 'Segoe UI Semibold'; -fx-font-weight: bold;"/>
                <Label fx:id="lblServicios" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="5">
                    <tooltip>
                        <Tooltip text="Servicios de interes seleccionados"/>
                    </tooltip>
                </Label>
            </GridPane>
        </HBox>
    </center>

    <bottom>
        <HBox alignment="CENTER_RIGHT"
              style="-fx-background-color: white; -fx-border-color: #dce5ec transparent transparent transparent; -fx-padding: 12 20;">
            <Button fx:id="btnCerrar" text="Volver a consulta" cancelButton="true" onAction="#cerrarVentana"
                    style="-fx-background-color: #f7fafc; -fx-border-color: #b7c5cf; -fx-border-radius: 8; -fx-background-radius: 8; -fx-text-fill: #173042; -fx-padding: 8 16;">
                <tooltip>
                    <Tooltip text="Cierra el detalle y regresa a la consulta"/>
                </tooltip>
            </Button>
        </HBox>
    </bottom>
</BorderPane>
