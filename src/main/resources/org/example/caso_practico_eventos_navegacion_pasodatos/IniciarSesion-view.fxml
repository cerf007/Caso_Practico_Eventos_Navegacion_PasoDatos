<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="420.0" prefWidth="640.0"
            style="-fx-background-color: #f4f7fb;"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.caso_practico_eventos_navegacion_pasodatos.controllers.IniciarSesionController">
    <top>
        <HBox alignment="CENTER_LEFT" style="-fx-background-color: #2f6f9f; -fx-padding: 18 24;">
            <Label text="Sistema de Clientes"
                   style="-fx-text-fill: white; -fx-font-size: 22px; -fx-font-weight: bold;"/>
        </HBox>
    </top>

    <center>
        <VBox alignment="CENTER" spacing="18.0">
            <Label text="Inicio de Sesión"
                   style="-fx-text-fill: #1f2937; -fx-font-size: 20px; -fx-font-weight: bold;"/>
            <Label text="Ingrese usuario y contraseña para continuar."
                   style="-fx-text-fill: #4b5563; -fx-font-size: 13px;"/>

            <GridPane hgap="12.0" vgap="14.0"
                      style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-color: #d1d5db; -fx-border-radius: 12; -fx-padding: 24;">
                <Label text="Usuario:" GridPane.columnIndex="0" GridPane.rowIndex="0"
                       style="-fx-text-fill: #374151; -fx-font-weight: bold;"/>
                <TextField fx:id="txtUsuario" promptText="admin" prefWidth="220.0"
                           GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                <Label text="Contraseña:" GridPane.columnIndex="0" GridPane.rowIndex="1"
                       style="-fx-text-fill: #374151; -fx-font-weight: bold;"/>
                <PasswordField fx:id="txtPassword" promptText="1234" prefWidth="220.0"
                               GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                <HBox alignment="CENTER_RIGHT" spacing="10.0" GridPane.columnIndex="1" GridPane.rowIndex="2">
                    <Button cancelButton="true" onAction="#salir" text="Salir"
                            style="-fx-background-color: #f3f4f6; -fx-border-color: #d1d5db; -fx-border-radius: 8; -fx-background-radius: 8; -fx-text-fill: #374151;"/>
                    <Button fx:id="btnIniciar" defaultButton="true" onAction="#iniciarSesion" text="Entrar"
                            style="-fx-background-color: #dcfce7; -fx-border-color: #4ade80; -fx-border-radius: 8; -fx-background-radius: 8; -fx-font-weight: bold; -fx-text-fill: #166534;"/>
                </HBox>
            </GridPane>
        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER_LEFT" style="-fx-background-color: white; -fx-padding: 10 18;">
            <Label text="Credenciales de prueba: admin / 1234"
                   style="-fx-text-fill: #6b7280; -fx-font-size: 12px;"/>
        </HBox>
    </bottom>

    <padding>
        <Insets bottom="0.0" left="0.0" right="0.0" top="0.0"/>
    </padding>
</BorderPane>
