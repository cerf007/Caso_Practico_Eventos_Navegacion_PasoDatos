<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="520.0" prefWidth="780.0" style="-fx-background-color: #edf2f7;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.caso_practico_eventos_navegacion_pasodatos.controllers.IniciarSesionController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="14.0" style="-fx-background-color: #123047; -fx-padding: 18 26;">
            <VBox spacing="2.0">
                <Label style="-fx-text-fill: white; -fx-font-family: 'Segoe UI Semibold'; -fx-font-size: 22px; -fx-font-weight: bold;" text="Sistema de Solicitudes de Clientes" />
                <Label style="-fx-text-fill: #cfe2ea; -fx-font-family: 'Segoe UI'; -fx-font-size: 12px;" text="Acceso al sistema de registro y consulta" />
            </VBox>
        </HBox>
    </top>

    <center>
        <VBox alignment="CENTER" spacing="16.0" style="-fx-padding: 34;">
            <VBox alignment="CENTER" spacing="6.0">
                <Label style="-fx-text-fill: #173042; -fx-font-family: 'Segoe UI Semibold'; -fx-font-size: 24px; -fx-font-weight: bold;" text="Inicio de sesion" />
                <Label style="-fx-text-fill: #657785; -fx-font-family: 'Segoe UI'; -fx-font-size: 13px;" text="Ingrese sus credenciales para continuar al menu principal" />
            </VBox>

            <GridPane alignment="CENTER" hgap="14.0" maxWidth="540.0" prefHeight="269.0" prefWidth="496.0" style="-fx-background-color: white; -fx-background-radius: 14; -fx-border-color: #d0dbe3; -fx-border-radius: 14; -fx-padding: 30; -fx-effect: dropshadow(gaussian, rgba(15,45,61,0.14), 16, 0, 0, 4);" vgap="13.0">
                <columnConstraints>
                    <ColumnConstraints minWidth="120.0" />
                    <ColumnConstraints minWidth="285.0" />
                </columnConstraints>
                <rowConstraints>
                    <RowConstraints minHeight="40.0" />
                    <RowConstraints minHeight="40.0" />
                    <RowConstraints minHeight="14.0" />
                    <RowConstraints minHeight="48.0" />
                    <RowConstraints minHeight="36.0" />
                </rowConstraints>

                <Label style="-fx-text-fill: #263845; -fx-font-family: 'Segoe UI Semibold'; -fx-font-size: 13px; -fx-font-weight: bold;" text="Usuario:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                <HBox alignment="CENTER_LEFT" spacing="8.0" style="-fx-background-color: #f8fbfc; -fx-border-color: #c8d5df; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 0 8;" GridPane.columnIndex="1" GridPane.rowIndex="0">
                    <Label style="-fx-text-fill: #173042; -fx-font-family: 'Segoe UI Emoji'; -fx-font-size: 15px;" text="👤" />
                    <TextField fx:id="txtUsuario" prefWidth="240.0" promptText="Ingrese el usuario" style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-padding: 9 0; -fx-font-family: 'Segoe UI'; -fx-font-size: 13px;">
                        <tooltip>
                            <Tooltip text="Usuario de prueba: admin" />
                        </tooltip>
                    </TextField>
                </HBox>

                <Label style="-fx-text-fill: #263845; -fx-font-family: 'Segoe UI Semibold'; -fx-font-size: 13px; -fx-font-weight: bold;" text="Contraseña:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                <HBox alignment="CENTER_LEFT" spacing="8.0" style="-fx-background-color: #f8fbfc; -fx-border-color: #c8d5df; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 0 8;" GridPane.columnIndex="1" GridPane.rowIndex="1">
                    <Label style="-fx-text-fill: #173042; -fx-font-family: 'Segoe UI Emoji'; -fx-font-size: 15px;" text="🔒" />
                    <PasswordField fx:id="txtPassword" prefWidth="240.0" promptText="Ingrese la contraseña" style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-padding: 9 0; -fx-font-family: 'Segoe UI'; -fx-font-size: 13px;">
                        <tooltip>
                            <Tooltip text="Contraseña de prueba: 1234" />
                        </tooltip>
                    </PasswordField>
                </HBox>

                <Separator GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="2" />

                <HBox alignment="CENTER" spacing="10.0" GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="3">
                    <Button cancelButton="true" onAction="#salir" style="-fx-background-color: #fff5f5; -fx-border-color: #d99a9a; -fx-border-radius: 8; -fx-background-radius: 8; -fx-text-fill: #8a1f1f; -fx-font-family: 'Segoe UI Semibold'; -fx-padding: 8 16;" text="Salir">
                        <tooltip>
                            <Tooltip text="Solicita confirmacion antes de cerrar la aplicacion" />
                        </tooltip>
                    </Button>
                    <Button fx:id="btnIniciar" defaultButton="true" onAction="#iniciarSesion" style="-fx-background-color: #0e7182; -fx-background-radius: 8; -fx-text-fill: white; -fx-font-family: 'Segoe UI Semibold'; -fx-font-weight: bold; -fx-padding: 8 20;" text="Iniciar sesion">
                        <tooltip>
                            <Tooltip text="Valida los campos y abre la ventana principal" />
                        </tooltip>
                    </Button>
                </HBox>
            </GridPane>
        </VBox>
    </center>

</BorderPane>
