<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ContextMenu?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="rootPane" prefHeight="520.0" prefWidth="820.0"
            style="-fx-background-color: #eef3f6;"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.caso_practico_eventos_navegacion_pasodatos.controllers.MenuPrincipalController">
    <fx:define>
        <ContextMenu fx:id="contextMenu"/>
    </fx:define>

    <top>
        <VBox>
            <HBox alignment="CENTER_LEFT" spacing="12.0"
                  style="-fx-background-color: linear-gradient(to right, #0f2d3d, #1f5d73); -fx-padding: 18 28;">
                <VBox spacing="2.0">
                    <Label text="Sistema de Solicitudes de Clientes"
                           style="-fx-text-fill: white; -fx-font-family: 'Segoe UI Semibold'; -fx-font-size: 24px; -fx-font-weight: bold;"/>
                    <Label text="Menu principal de navegacion"
                           style="-fx-text-fill: #d6e8ef; -fx-font-family: 'Segoe UI'; -fx-font-size: 12px;"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <HBox alignment="CENTER" spacing="8.0"
                      style="-fx-background-color: rgba(255,255,255,0.14); -fx-background-radius: 18; -fx-padding: 6 12;">
                    <Label text="&#128100;"
                           style="-fx-text-fill: white; -fx-font-family: 'Segoe UI Emoji'; -fx-font-size: 18px;"/>
                    <Label text="Usuario activo: admin"
                           style="-fx-text-fill: white; -fx-font-family: 'Segoe UI Semibold'; -fx-font-size: 12px; -fx-font-weight: bold;"/>
                </HBox>
            </HBox>

            <MenuBar>
                <menus>
                    <Menu text="Clientes">
                        <items>
                            <MenuItem text="Registrar cliente" onAction="#abrirRegistro"/>
                            <MenuItem text="Consultar clientes" onAction="#abrirConsulta"/>
                            <SeparatorMenuItem/>
                            <MenuItem text="Exportar datos" onAction="#exportarDatos"/>
                        </items>
                    </Menu>
                    <Menu text="Acciones">
                        <items>
                            <MenuItem text="Refrescar sistema" onAction="#refrescarSistema"/>
                            <MenuItem text="Informacion del sistema" onAction="#mostrarDialogoSistema"/>
                        </items>
                    </Menu>
                </menus>
            </MenuBar>

            <ToolBar style="-fx-background-color: #f8fbfc; -fx-border-color: #dce5ec transparent #dce5ec transparent;">
                <items>
                    <Button text="Registrar cliente" onAction="#abrirRegistro"
                            style="-fx-background-color: white; -fx-border-color: #b7c5cf; -fx-border-radius: 7; -fx-background-radius: 7; -fx-text-fill: #173042;">
                        <tooltip>
                            <Tooltip text="Abre el formulario de registro"/>
                        </tooltip>
                    </Button>
                    <Button text="Consultar clientes" onAction="#abrirConsulta"
                            style="-fx-background-color: white; -fx-border-color: #b7c5cf; -fx-border-radius: 7; -fx-background-radius: 7; -fx-text-fill: #173042;">
                        <tooltip>
                            <Tooltip text="Muestra los clientes registrados en una tabla"/>
                        </tooltip>
                    </Button>
                    <Button text="Exportar datos" onAction="#exportarDatos"
                            style="-fx-background-color: white; -fx-border-color: #b7c5cf; -fx-border-radius: 7; -fx-background-radius: 7; -fx-text-fill: #173042;">
                        <tooltip>
                            <Tooltip text="Selecciona una carpeta para exportar reportes"/>
                        </tooltip>
                    </Button>
                </items>
            </ToolBar>
        </VBox>
    </top>

    <center>
        <VBox alignment="CENTER" spacing="20.0" style="-fx-padding: 30;">
            <VBox alignment="CENTER" spacing="8.0">
                <Label text="Gestion de solicitudes"
                       style="-fx-text-fill: #173042; -fx-font-family: 'Segoe UI Semibold'; -fx-font-size: 22px; -fx-font-weight: bold;"/>
                <Label text="Seleccione una accion para registrar, consultar o exportar informacion."
                       style="-fx-text-fill: #657785; -fx-font-family: 'Segoe UI'; -fx-font-size: 12px;"/>
            </VBox>

            <HBox alignment="CENTER" spacing="18.0">
                <Button onAction="#abrirRegistro" prefHeight="118.0" prefWidth="150.0"
                        style="-fx-background-color: white; -fx-border-color: #0e7182; -fx-border-radius: 12; -fx-background-radius: 12; -fx-text-fill: #0e5160; -fx-font-family: 'Segoe UI Semibold'; -fx-font-size: 15px; -fx-font-weight: bold; -fx-effect: dropshadow(gaussian, rgba(15,45,61,0.12), 12, 0, 0, 3);">
                    <graphic>
                        <VBox alignment="CENTER" spacing="8.0">
                            <Label text="&#128100;"
                                   style="-fx-text-fill: #6c4df6; -fx-font-family: 'Segoe UI Emoji'; -fx-font-size: 34px;"/>
                            <Label text="Registrar&#10;Cliente"
                                   style="-fx-text-fill: #263845; -fx-font-family: 'Segoe UI Semibold'; -fx-font-size: 13px; -fx-font-weight: bold; -fx-text-alignment: center;"/>
                        </VBox>
                    </graphic>
                    <tooltip>
                        <Tooltip text="Registrar cliente"/>
                    </tooltip>
                </Button>
                <Button onAction="#abrirConsulta" prefHeight="118.0" prefWidth="150.0"
                        style="-fx-background-color: white; -fx-border-color: #0e7182; -fx-border-radius: 12; -fx-background-radius: 12; -fx-text-fill: #0e5160; -fx-font-family: 'Segoe UI Semibold'; -fx-font-size: 15px; -fx-font-weight: bold; -fx-effect: dropshadow(gaussian, rgba(15,45,61,0.12), 12, 0, 0, 3);">
                    <graphic>
                        <VBox alignment="CENTER" spacing="8.0">
                            <Label text="&#9776;"
                                   style="-fx-text-fill: #0e7182; -fx-font-family: 'Segoe UI Semibold'; -fx-font-size: 35px;"/>
                            <Label text="Consultar&#10;Clientes"
                                   style="-fx-text-fill: #263845; -fx-font-family: 'Segoe UI Semibold'; -fx-font-size: 13px; -fx-font-weight: bold; -fx-text-alignment: center;"/>
                        </VBox>
                    </graphic>
                    <tooltip>
                        <Tooltip text="Consultar clientes"/>
                    </tooltip>
                </Button>
                <Button onAction="#exportarDatos" prefHeight="118.0" prefWidth="150.0"
                        style="-fx-background-color: white; -fx-border-color: #8ea1ad; -fx-border-radius: 12; -fx-background-radius: 12; -fx-text-fill: #344653; -fx-font-family: 'Segoe UI Semibold'; -fx-font-size: 15px; -fx-font-weight: bold; -fx-effect: dropshadow(gaussian, rgba(15,45,61,0.12), 12, 0, 0, 3);">
                    <graphic>
                        <VBox alignment="CENTER" spacing="8.0">
                            <Label text="&#128196;"
                                   style="-fx-text-fill: #e46b2d; -fx-font-family: 'Segoe UI Emoji'; -fx-font-size: 34px;"/>
                            <Label text="Exportar&#10;Datos"
                                   style="-fx-text-fill: #263845; -fx-font-family: 'Segoe UI Semibold'; -fx-font-size: 13px; -fx-font-weight: bold; -fx-text-alignment: center;"/>
                        </VBox>
                    </graphic>
                    <tooltip>
                        <Tooltip text="Exportar datos"/>
                    </tooltip>
                </Button>
            </HBox>

            <Label text="Clic derecho sobre esta ventana para abrir el menu contextual."
                   style="-fx-text-fill: #657785; -fx-font-family: 'Segoe UI'; -fx-font-size: 12px;"/>
        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER_LEFT" style="-fx-background-color: white; -fx-border-color: #dce5ec transparent transparent transparent; -fx-padding: 12 20;">
            <Label text="Aplicacion de escritorio para registro y consulta de solicitudes"
                   style="-fx-text-fill: #657785; -fx-font-family: 'Segoe UI'; -fx-font-size: 12px;"/>
        </HBox>
    </bottom>
</BorderPane>
